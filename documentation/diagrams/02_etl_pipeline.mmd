flowchart LR
  CSV["data/raw/*.csv"] --> Ingest["IngestionService"]
  Ingest --> Hash["IngestFileDAO upsert hash"]
  Ingest --> Raw["raw_ingest pending"]
  Ingest --> Clean["CleaningOrchestrator"]
  Clean --> T["TextCleaner"]
  T --> N["NullCleaner"]
  N --> D["DuplicateCleaner"]
  D --> S["SchemaCleaner"]
  S --> Report["ReportService → cleaning_report"]
  S --> Persist["PersistenceService"]
  Persist --> Content["content + article|news"]
  Persist --> Evidence["evidence"]
  Persist --> Reject["raw_ingest rejected"]
